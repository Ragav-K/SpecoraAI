rules_version = '2';

// Specora AI stores all application data in MongoDB and never reads or writes
// Firestore. Firebase is used for static hosting only. These rules therefore
// deny everything: the previous scaffolded "allow all until <date>" rules left
// the database world-readable and world-writable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
