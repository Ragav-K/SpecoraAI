# Specora AI — Environment Template
# Copy this to specora-ai/backend/.env and fill in real values.

# ── Core ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local).
MONGODB_URI=your_mongodb_connection_string

# Secret used to sign session JWTs.
# REQUIRED in production — the server refuses to start without it. In
# development a random per-process secret is generated instead, which
# invalidates every session on restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret

# ── Transcription (AssemblyAI) ──────────────────────────────────
ASSEMBLYAI_API_KEY=your_assemblyai_key

# ── AI analysis ─────────────────────────────────────────────────
# AI_PROVIDER selects the backend: openai | groq | mock
# Only the selected provider's key is required.
AI_PROVIDER=openai

OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL=gpt-4o

# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Legacy switch, still honoured: MOCK_AI=true forces mock analysis AND a mock
# transcript, so neither AssemblyAI nor the AI provider is called at all.
# MOCK_AI=false

# ── Email (OTP + password reset) ────────────────────────────────
# EMAIL_PROVIDER selects the backend: resend | brevo | console
#   resend  — needs a DNS-verified domain (or the sandbox sender below, which
#             only delivers to the Resend account owner)
#   brevo   — no domain needed, but EMAIL_FROM must be a verified sender
#   console — prints the code to the server log; local development only
EMAIL_PROVIDER=resend

RESEND_API_KEY=your_resend_key
# BREVO_API_KEY=your_brevo_key

# Sender identity. Required for brevo; for resend it falls back to
# onboarding@resend.dev when unset.
EMAIL_FROM=you@yourdomain.com
EMAIL_FROM_NAME=Specora AI
